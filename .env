LLM_PROVIDER=ollama

TEXT_API_KEY="ollama"
TEXT_BASE_URL="http://localhost:11434/v1"
VISION_API_KEY="ollama"
VISION_BASE_URL="http://localhost:11434/v1"
IMAGE_GEN_API_KEY="ollama"
IMAGE_GEN_BASE_URL="http://localhost:11434/v1"
IMAGE_GEN_BACKEND="zimage"
DEEPL_API_KEY=""
DEEPSEEK_API_KEY="ollama"
DEEPSEEK_BASE_URL="http://localhost:11434/v1"

OLLAMA_BASE_URL=http://localhost:11434

# Language settings
OUTPUT_LANGUAGE=en
RUBRIC_LANGUAGE=en
TRANSLATION_PROVIDER=none

# Text-only tasks (JSON, rubrics, structured outputs)
TEXT_MODEL=qwen2.5:72b-instruct-q4_K_M-64k
ADVERSARIAL_MODEL = qwen2.5:72b-instruct-q4_K_M
# Vision tasks (image analysis, multimodal)
VISION_MODEL=qwen3-vl:30b-a3b-instruct

# Judging/evaluation (needs strong reasoning capabilities)
JUDGE_MODEL=deepseek-r1:70B

# Transmuter pipeline
TRANSMUTER_PRIMARY_MODEL=qwen3-vl-restricted:latest
TRANSMUTER_FALLBACK_MODEL=gemma4:latest

# Generation params
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=4096

# OpenAI-compatible fallback for local Ollama
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
EXPORT_RESULTS_DIR="./logs/attack_runs/"
