# COMET environment variable example (Ollama-first local configuration)
# Copy to .env and adjust for your environment

# Ollama (OpenAI-compatible) defaults
OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama does not require an API key, but the field is kept for OpenAI SDK compatibility
TEXT_API_KEY=ollama
VISION_API_KEY=ollama
IMAGE_GEN_API_KEY=ollama

# Model selection (recommended for local use)
TEXT_MODEL=qwen3-vl:30b-a3b-instruct
VISION_MODEL=qwen3-vl:30b-a3b-instruct
ADVERSARIAL_MODEL=huihui_ai/qwen3-vl-abliterated:30b-a3b-instruct-q8_0
JUDGE_MODEL=qwen3-vl:32b

# Legacy fields kept for backward compatibility
TEXT_BASE_URL=${OLLAMA_BASE_URL}
VISION_BASE_URL=${OLLAMA_BASE_URL}
IMAGE_GEN_BASE_URL=${OLLAMA_BASE_URL}

# Image generation backend: local_pillow | draw_things | remote
IMAGE_GEN_BACKEND=local_pillow
DRAW_THINGS_API_URL=http://127.0.0.1:7860/api/v1/generate

# Generation parameters
DEFAULT_TEMPERATURE=0.2
MAX_TOKENS=4096
LLM_TIMEOUT=300
EVAL_MAX_TOKENS=4096

OUTPUT_LANGUAGE=en
RUBRIC_LANGUAGE=en
POLISHING_MODE=vlm
LOCATION_NEUTRALIZATION=1
TRANSLATION_PROVIDER=none
DEEPL_API_KEY=

# Other optional settings
ENTITY_EXTRACTION_MODE=dynamic
DISRACTION_ENTITY_ENABLED=1
